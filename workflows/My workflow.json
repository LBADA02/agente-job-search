    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst failedEmails = new Set();\nconst sheetRows = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Failed-email items\n  if (data.email) {\n    failedEmails.add(\n      data.email.trim().toLowerCase()\n    );\n  }\n\n  // Google Sheets rows\n  if (data['Email (exact as supplied)']) {\n    sheetRows.push(data);\n  }\n}\n\nconst matches = [];\n\nfor (const row of sheetRows) {\n  const sheetEmail = row['Email (exact as supplied)']\n    ?.trim()\n    .toLowerCase();\n\n  if (sheetEmail && failedEmails.has(sheetEmail)) {\n    matches.push({\n      json: row\n    });\n  }\n}\n\nreturn matches;"
      },
